# Build and image source
ZT_VERSION=1.16.2
ZTNCUI_COMMIT=1b2284864de48d2dcae22582fff122fe24909c3d
MKWORLD_ZT_VERSION=1.14.2
# Use "default" outside regions where the Aliyun Debian mirror is useful.
DEBIAN_MIRROR=mirrors.aliyun.com
ZT_IMAGE=zerotier-planet:1.16.2-optimized
# build: compile this checkout; pull: pull ZT_IMAGE from a registry.
IMAGE_SOURCE=build
# Repository URL written to OCI image metadata.
SOURCE_REPOSITORY=https://github.com/Csneer/ms-zerotier-planet

# Persistent state and checksummed backups
DATA_DIR=./data/zerotier
ZTNCUI_STATE_DIR=./data/zerotier/ztncui-state
# Optional local ZeroTier client used as a DIRECT/RELAY observation probe.
ZT_PROBE_STATE_DIR=./data/zerotier/probe-state
BACKUP_DIR=./backups
# Use a unique name for independent instances or when retaining an old container.
CONTAINER_NAME=myztplanet

# Runtime configuration
IP_ADDR4=203.0.113.10
IP_ADDR6=
ZT_PORT=9994
API_PORT=3443
DEFAULT_NETWORK_MTU=1280
HTTP_HOST=127.0.0.1
# Optional explicit LAN IPs, comma-separated; never a subnet or wildcard.
# Example: HTTP_EXTRA_HOSTS=172.16.100.97
HTTP_EXTRA_HOSTS=
# generated: single Root with local signing. external: load a verified signed
# Planet from config/planet (required for multi-root, recommended for backup Roots).
PLANET_MODE=generated
# 1: run only a Root; no Web UI. Use a dedicated identity/data directory.
ROOT_ONLY=0
# 1: run the Controller/Web UI without making this identity a Planet Root.
# Requires PLANET_MODE=external and an existing identity/data directory. The
# supplied Planet must not contain this identity as a Root; ROOT_ONLY is
# mutually exclusive. A controller-standby guard may further restrict startup.
CONTROLLER_ONLY=0
ZT_PROBE_ADDR=http://127.0.0.1:9993
# Optional bounded TCP probes; absent means no endpoint probing.
ZT_ENDPOINT_PROBES_FILE=/app/config/endpoint-probes.json
TZ=Asia/Shanghai
