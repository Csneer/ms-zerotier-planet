# Build and image source
ZT_VERSION=1.16.2
ZTNCUI_COMMIT=1b2284864de48d2dcae22582fff122fe24909c3d
MKWORLD_ZT_VERSION=1.14.2
# Use "default" outside regions where the Aliyun Debian mirror is useful.
DEBIAN_MIRROR=mirrors.aliyun.com
ZT_IMAGE=zerotier-planet:1.16.2-optimized
# build: compile this checkout; pull: pull ZT_IMAGE from a registry.
IMAGE_SOURCE=build
# Repository URL written to OCI image metadata.
SOURCE_REPOSITORY=https://github.com/Csneer/ms-zerotier-planet

# Persistent state and checksummed backups
DATA_DIR=./data/zerotier
ZTNCUI_STATE_DIR=./data/zerotier/ztncui-state
BACKUP_DIR=./backups
# Change only when running more than one independent instance on a host.
CONTAINER_NAME=myztplanet

# Runtime configuration
IP_ADDR4=203.0.113.10
IP_ADDR6=
ZT_PORT=9994
API_PORT=3443
FILE_SERVER_PORT=3000
DEFAULT_NETWORK_MTU=1280
HTTP_HOST=0.0.0.0
TZ=Asia/Shanghai
