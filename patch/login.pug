extends login_layout

block login_content
  .auth-heading
    span.eyebrow Secure administration
    h1 Welcome back
    p Sign in to manage networks and download configuration files.

  if error
    .alert.alert-danger= error
  if message
    .alert.alert-info
      strong= message

  form(method='POST' action='')
    .form-group
      label(for='username') Username
      .input-group.input-group-lg
        span.input-group-addon
          i.glyphicon.glyphicon-user
        input#username.form-control(type='text' name='username' placeholder='Enter your username' autocomplete='username' required=true autofocus=true)
    .form-group
      label(for='password') Password
      .input-group.input-group-lg
        span.input-group-addon
          i.glyphicon.glyphicon-lock
        input#password.form-control(type='password' name='password' placeholder='Enter your password' autocomplete='current-password' required=true)
    button.btn.btn-primary.btn-lg.btn-block(type='submit') Sign in
