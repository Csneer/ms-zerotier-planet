//-
  MTU editor added by docker-zerotier-planet optimized build.

extends network_layout

block net_content
  section.surface-card.form-card
    .card-heading
      div
        h2= t('mtu.title')
        p= t('mtu.description')

    if success
      .alert.alert-success(role='alert')= t('mtu.updated', {value: network.mtu})

    if errors
      .alert.alert-danger(role='alert')
        ul.compact-list
          each err in errors
            li= localize_error(err.msg)

    .alert.alert-info(role='alert')
      strong= t('mtu.recommendation')

    form(method='POST' action='')
      .form-group
        label(for='mtuInput')= t('mtu.range')
        input#mtuInput.form-control.form-control-narrow(
          type='number'
          name='mtu'
          min='1280'
          max='2800'
          step='1'
          required=true
          value=(submittedMtu !== undefined ? submittedMtu : network.mtu)
        )
      .form-group.button-row
        button.btn.btn-default.mtuPreset(type='button' data-mtu='1280') 1280 (#{t('mtu.recommended')})
        button.btn.btn-default.mtuPreset(type='button' data-mtu='1400') 1400
        button.btn.btn-default.mtuPreset(type='button' data-mtu='2800') 2800 (#{t('mtu.default')})
      .form-actions
        button.btn.btn-primary(type='submit')= t('mtu.save')
        a.btn.btn-default(href='/controller/network/' + network.nwid)= t('common.cancel')

  script.
    $(function() {
      $('.mtuPreset').on('click', function() {
        $('#mtuInput').val($(this).data('mtu')).focus();
      });
    });
