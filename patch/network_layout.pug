extends controller_layout

block content
  if error
    .alert.alert-danger= error
  else
    .page-heading
      div
        span.eyebrow= t('network.config_eyebrow')
        block network_title
          h1
            a(href='/controller/network/' + network.nwid)= network.name
          code.page-network-id= network.nwid
      if navigate && navigate.whence
        a.btn.btn-default(href=navigate.whence role='button')
          span.glyphicon.glyphicon-arrow-left(aria-hidden='true')
          |  #{t('common.back')}
    block net_content
