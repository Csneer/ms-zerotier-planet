extends head_layout

block nav_items
  +nav_item('controller_home', 'Dashboard', '/controller', 'dashboard')
  +nav_item('networks', 'Networks', '/controller/networks', 'globe')
  +nav_item('add_network', 'New network', '/controller/network/create', 'plus')
  +nav_item('downloads', 'Downloads', '/controller/downloads', 'download-alt')
  +nav_item('users', 'Users', '/users', 'user')

block body_content
  main.container.app-shell
    .page-heading
      div
        span.eyebrow Access control
        h1= title
      a.btn.btn-primary(href='/users/create')
        span.glyphicon.glyphicon-plus(aria-hidden='true')
        |  Create user
    if error
      .alert.alert-danger= error
    else
      .surface-card
        block users_content
