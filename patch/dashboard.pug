extends controller_layout
include roots_panel

block content
  if error
    .alert.alert-danger
      strong= t('dashboard.error')
      | #{error}
  else
    section.hero-card
      .hero-copy
        span.eyebrow= t('dashboard.eyebrow')
        h1= t('dashboard.heading')
        p= t('dashboard.description')
        .hero-actions
          a.btn.btn-primary.btn-lg(href='/controller/networks')
            span.glyphicon.glyphicon-globe(aria-hidden='true')
            |  #{t('dashboard.manage_networks')}
          a.btn.btn-default.btn-lg(href='/controller/downloads')
            span.glyphicon.glyphicon-download-alt(aria-hidden='true')
            |  #{t('dashboard.download_planet')}
      .hero-status-group
        .hero-status
          span.status-pill(class=zt_status.online ? 'is-online' : 'is-offline')
            span.status-dot
            | #{zt_status.online ? t('dashboard.online') : t('dashboard.offline')}
          small= t('dashboard.controller_status')
        .hero-status
          if dashboard_stats && dashboard_stats.available
            strong.hero-status-value #{dashboard_stats.planetReachableMemberCount} / #{dashboard_stats.memberCount}
          else
            strong.hero-status-value —
          small= dashboard_stats && dashboard_stats.available ? t('dashboard.planet_reachable_devices') : t('dashboard.stats_unavailable')

    .row.status-grid
      .col-sm-4
        .stat-card
          .stat-icon
            span.glyphicon.glyphicon-screenshot
          .stat-content
            span.stat-label= t('dashboard.node_address')
            strong= zt_status.address
      .col-sm-4
        .stat-card
          .stat-icon
            span.glyphicon.glyphicon-tags
          .stat-content
            span.stat-label= t('dashboard.zt_version')
            strong= zt_status.version
      .col-sm-4
        .stat-card
          .stat-icon
            span.glyphicon.glyphicon-transfer
          .stat-content
            span.stat-label= t('dashboard.tcp_fallback')
            strong= zt_status.tcpFallbackActive ? t('dashboard.active') : t('dashboard.inactive')

    +roots_panel(topology, uiListeners)

    .section-heading
      div
        span.eyebrow= t('dashboard.quick_actions')
        h2= t('dashboard.quick_heading')

    .row.action-grid
      .col-sm-6.col-lg-3
        a.action-card(href='/controller/monitor')
          span.action-icon.action-green
            span.glyphicon.glyphicon-signal
          strong= t('nav.monitor')
          p= t('dashboard.monitor_description')
          span.action-link= t('dashboard.open_monitor')
      .col-sm-6.col-lg-3
        a.action-card(href='/controller/networks')
          span.action-icon.action-blue
            span.glyphicon.glyphicon-globe
          strong= t('nav.networks')
          p= t('dashboard.networks_description')
          span.action-link= t('dashboard.open_networks')
      .col-sm-6.col-lg-3
        a.action-card(href='/controller/network/create')
          span.action-icon.action-violet
            span.glyphicon.glyphicon-plus
          strong= t('nav.new_network')
          p= t('dashboard.new_network_description')
          span.action-link= t('dashboard.create_network')
      .col-sm-6.col-lg-3
        a.action-card(href='/controller/downloads')
          span.action-icon.action-cyan
            span.glyphicon.glyphicon-download-alt
          strong= t('dashboard.config_files')
          p= t('dashboard.config_description')
          span.action-link= t('dashboard.view_downloads')
      .col-sm-6.col-lg-3
        a.action-card(href='/users')
          span.action-icon.action-green
            span.glyphicon.glyphicon-user
          strong= t('dashboard.administrators')
          p= t('dashboard.admin_description')
          span.action-link= t('dashboard.manage_users')
