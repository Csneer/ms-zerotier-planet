extends controller_layout
include roots_panel

block content
  if error
    .alert.alert-danger
      strong= t('dashboard.error')
      | #{error}
  else
    section.hero-card.dashboard-overview
      .hero-copy
        h1= t('nav.dashboard')
      .hero-status
        span.status-pill(class=zt_status.online ? 'is-online' : 'is-offline')
          span.status-dot(aria-hidden='true')
          | #{zt_status.online ? t('dashboard.online') : t('dashboard.offline')}
        small= t('dashboard.controller_status')

    .dashboard-stat-grid(role='group' aria-label=t('ux.overview_stats'))
      .stat-card
        .stat-icon.stat-icon-cyan
          +app_icon('globe')
        .stat-content
          span.stat-label= t('nav.networks')
          strong= dashboard_stats && dashboard_stats.available ? dashboard_stats.networkCount : '—'
          if !dashboard_stats || !dashboard_stats.available
            small.stat-meta= t('dashboard.stats_unavailable')
      .stat-card
        .stat-icon.stat-icon-green
          +app_icon('user')
        .stat-content
          span.stat-label= t('network.member_total')
          strong= dashboard_stats && dashboard_stats.available ? dashboard_stats.memberCount : '—'
          if !dashboard_stats || !dashboard_stats.available
            small.stat-meta= t('dashboard.stats_unavailable')
      .stat-card
        .stat-icon.stat-icon-cyan
          +app_icon('signal')
        .stat-content
          span.stat-label= t('dashboard.planet_reachable_devices')
          strong= dashboard_stats && dashboard_stats.available ? dashboard_stats.planetReachableMemberCount : '—'
          small.stat-meta= t('dashboard.reachability_scope')
    +roots_panel(topology, uiListeners, true)

    .section-heading
      div
        h2= t('dashboard.quick_actions')

    .dashboard-action-grid
      a.action-card.action-card-featured(href='/controller/networks')
        span.action-icon.action-blue
          +app_icon('globe')
        strong= t('nav.networks')
        p= t('dashboard.networks_description')
        span.action-link(aria-hidden='true')
          +app_icon('arrow-right')
      a.action-card(href='/controller/network/create')
        span.action-icon.action-violet
          +app_icon('plus')
        strong= t('nav.new_network')
        p= t('dashboard.new_network_description')
        span.action-link(aria-hidden='true')
          +app_icon('arrow-right')
      a.action-card(href='/controller/downloads')
        span.action-icon.action-cyan
          +app_icon('download-alt')
        strong= t('dashboard.download_planet')
        p= t('dashboard.config_description')
        span.action-link(aria-hidden='true')
          +app_icon('arrow-right')
      a.action-card(href='/controller/monitor')
        span.action-icon.action-green
          +app_icon('signal')
        strong= t('nav.monitor')
        p= t('dashboard.monitor_description')
        span.action-link(aria-hidden='true')
          +app_icon('arrow-right')

    details.monitor-disclosure.dashboard-management(data-dialog)
      summary= t('dashboard.management')
      .disclosure-body
        .monitor-topology-meta
          .detail-item
            span= t('dashboard.node_address')
            code= zt_status.address
          .detail-item
            span= t('dashboard.zt_version')
            strong= zt_status.version
          .detail-item
            span= t('dashboard.tcp_fallback')
            strong= zt_status.tcpFallbackActive ? t('dashboard.active') : t('dashboard.inactive')
        a.btn.btn-default(href='/users')
          +app_icon('user')
          |  #{t('dashboard.administrators')}
