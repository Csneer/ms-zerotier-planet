extends network_layout

block net_content
  - const memberId = member.id || member.address;
  - const peer = member.peer;
  - const paths = peer && Array.isArray(peer.paths) ? peer.paths.filter(function(path) { return path && path.active === true && path.expired !== true; }) : [];
  - const online = Boolean(peer && peer.role === 'LEAF' && paths.length);
  - const activityTimes = paths.reduce(function(values, path) { if (Number(path.lastReceive) > 0) values.push(Number(path.lastReceive)); if (Number(path.lastSend) > 0) values.push(Number(path.lastSend)); return values; }, []);
  - const lastActivity = activityTimes.length ? new Date(Math.max.apply(Math, activityTimes)) : null;
  section.surface-card.form-card
    .card-heading
      div
        h2= t('member.detail_title')
        p #{member.name || t('member.name')} · #{memberId}
      span.member-status(class=online ? 'is-online' : 'is-unknown')
        span.status-dot
        | #{online ? t('network.planet_reachable_short') : t('network.planet_unreachable_short')}

    .detail-grid
      .detail-item
        span= t('member.name')
        strong= member.name || t('common.none')
      .detail-item
        span= t('member.address')
        code= memberId
      .detail-item
        span= t('network.authorized')
        strong= member.authorized ? t('common.enabled') : t('common.disabled')
      .detail-item
        span= t('network.bridge')
        strong= member.activeBridge ? t('common.enabled') : t('common.disabled')
      .detail-item
        span= t('member.client_version')
        strong= peer && peer.version && peer.version !== '-1.-1.-1' ? peer.version : t('common.unknown')
      .detail-item
        span= t('member.observed_latency')
        strong= paths.length && peer && typeof peer.latency === 'number' && Number.isFinite(peer.latency) && peer.latency >= 0 ? peer.latency + ' ms' : t('common.unknown')
      .detail-item.detail-item-wide
        span= t('member.observed_paths')
        if paths.length
          .ip-list
            each path in paths
              code= path.address || t('common.unknown')
        else
          strong= t('member.no_observed_path')
      .detail-item.detail-item-wide
        span= t('member.path_activity')
        if lastActivity && Number.isFinite(lastActivity.getTime())
          time(datetime=lastActivity.toISOString())= lastActivity.toISOString()
        else
          strong= t('common.unknown')
      .detail-item.detail-item-wide
        span= t('network.ip_assignment')
        if member.ipAssignments && member.ipAssignments.length
          .ip-list
            each ipAddress in member.ipAssignments
              code= ipAddress
        else
          strong= t('network.no_ip')

    p.monitor-footnote= t('network.planet_scope_note')

    .form-actions
      a.btn.btn-primary(href='/controller/network/' + network.nwid + '/member/' + memberId + '/ipAssignments')= t('network.edit_ip')
      a.btn.btn-default(href='/controller/network/' + network.nwid + '#members')= t('member.back')

  details.surface-card.advanced-details(data-dialog)
    summary
      span.glyphicon.glyphicon-console(aria-hidden='true')
      span= t('common.advanced_data')
    .advanced-details-body
      p= t('common.raw_json_hint')
      pre= JSON.stringify(member, null, 2)
