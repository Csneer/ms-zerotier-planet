extends controller_layout
include roots_panel

block content
  .page-heading
    div
      h1= t('monitor.title')
      p= t('ux.monitor_snapshot', {time: monitor && monitor.generatedAt || '—'})
    a.btn.btn-default(href='/controller/monitor')
      +app_icon('refresh')
      |  #{t('common.refresh')}

  if error
    .alert.alert-danger= error
  else
    if !monitor.service.planetMatches || !monitor.service.rootConfigAvailable || monitor.service.unexpectedPlanetCount
      .alert.alert-danger.monitor-alert
        strong= t('monitor.planet_problem')
        p= t('monitor.planet_problem_desc', {count: monitor.service.unexpectedPlanetCount === null ? '—' : monitor.service.unexpectedPlanetCount})
        a.btn.btn-default.btn-sm(href='#planet-guidance' data-dialog-open='planet-guidance')= t('guide.actions')
    if monitor.summary.bridgeMemberCount
      .alert.alert-warning.monitor-alert
        strong= t('monitor.bridge_warning', {count: monitor.summary.bridgeMemberCount})
        p= t('monitor.bridge_warning_desc')
        a.btn.btn-default.btn-sm(href='#bridge-guidance' data-dialog-open='bridge-guidance')= t('guide.actions')

    if monitor.communication
      section#network-health.surface-card.table-card.monitor-network-card(data-list data-list-summary=t('ux.list_count'))
        .card-heading.card-heading-padded
          div
            h2= t('monitor.network_health')
            p= t('monitor.network_health_desc')
        .monitor-communication-grid
          .detail-item
            span= t('monitor.communication_members')
            strong #{monitor.communication.memberCount} / #{monitor.communication.networkCount} #{t('monitor.communication_networks')}
          .detail-item
            span= t('monitor.communication_planet_coverage')
            strong= monitor.communication.planetCoveragePercent === null ? '—' : monitor.communication.planetCoveragePercent + '%'
            small.monitor-path-meta #{monitor.communication.planetReachableCount} / #{monitor.communication.planetObservedCount} #{t('monitor.communication_observed_short')}; #{monitor.communication.planetUnknownCount} #{t('monitor.communication_unknown_short')}
          .detail-item
            span= t('monitor.communication_direct')
            strong= monitor.probe.available ? monitor.communication.probeDirectCount : '—'
          .detail-item
            span= t('monitor.communication_relay')
            strong= monitor.probe.available ? monitor.communication.probeRelayCount : '—'
          .detail-item
            span= t('monitor.communication_unknown')
            strong= monitor.probe.available ? monitor.communication.probeUnknownCount : '—'
          .detail-item
            span= t('monitor.communication_risk')
            strong #{monitor.communication.oldVersionCount} #{t('monitor.communication_old')} · #{monitor.communication.bridgeCount} #{t('monitor.communication_bridge')}
        .list-toolbar(data-list-controls hidden)
          input.form-control(type='search' data-list-search placeholder=t('ux.search_networks') aria-label=t('ux.search_networks'))
        .table-responsive
          table.table.app-table.monitor-table
            thead
              tr
                th= t('monitor.network_name')
                th= t('monitor.network_members')
                th= t('monitor.network_planet_coverage')
                th= t('monitor.network_probe_paths')
                th= t('monitor.network_risk')
            tbody
              each network in monitor.networkStats
                - const networkClass = network.state === 'healthy' ? 'is-direct' : ['degraded', 'partial'].includes(network.state) ? 'is-relay' : 'is-unknown';
                tr(data-list-row data-search=[network.name, network.nwid].join(' '))
                  td
                    strong= network.name || network.nwid
                    code.monitor-member-id= network.nwid
                    if network.mtu
                      small.monitor-path-meta MTU #{network.mtu}
                  td
                    | #{network.authorizedCount} / #{network.memberCount}
                    small.monitor-path-meta= t('monitor.network_authorized')
                  td
                    span.path-badge(class=networkClass)= t('monitor.network_state_' + network.state)
                    small.monitor-path-meta #{network.planetReachableCount} / #{network.planetObservedCount} #{t('monitor.communication_observed_short')}#{network.planetCoveragePercent === null ? '' : ' (' + network.planetCoveragePercent + '%)'}
                    if network.planetUnknownCount
                      small.monitor-path-meta #{network.planetUnknownCount} #{t('monitor.communication_unknown_short')}
                  td
                    if monitor.probe.available
                      span.monitor-path-meta #{network.probeDirectCount} #{t('monitor.communication_direct_short')} · #{network.probeRelayCount} #{t('monitor.communication_relay_short')} · #{network.probeUnknownCount} #{t('monitor.communication_unknown_short')}
                      if network.directPercent !== null
                        small.monitor-path-meta= t('monitor.network_direct_percent', {value: network.directPercent})
                    else
                      span.muted-text= t('monitor.probe_unavailable')
                  td
                    if network.oldVersionCount
                      a.risk-badge(href='#version-guidance' data-dialog-open='version-guidance') #{network.oldVersionCount} #{t('monitor.communication_old')}
                    if network.bridgeCount
                      a.risk-badge(href='#bridge-guidance' data-dialog-open='bridge-guidance') #{network.bridgeCount} #{t('monitor.communication_bridge')}
                    if !network.oldVersionCount && !network.bridgeCount
                      span.muted-text= t('common.none')
              else
                tr
                  td.empty-table-cell(colspan='5')= t('monitor.no_networks')
        p.list-empty(data-list-empty hidden)= t('ux.no_results')
        .list-pagination(data-list-controls hidden)
          output(data-list-count aria-live='polite')
          .list-pagination-actions
            button.btn.btn-default.btn-sm(type='button' data-list-prev)= t('ux.previous')
            button.btn.btn-default.btn-sm(type='button' data-list-next)= t('ux.next')
        details.scope-disclosure(data-dialog)
          summary= t('ux.scope_details')
          p.monitor-footnote= t('monitor.communication_scope_note')

    +roots_panel(topology, uiListeners)

    section#member-paths.surface-card.table-card.monitor-member-card(data-list data-list-summary=t('ux.list_count'))
      .card-heading.card-heading-padded
        div
          h2= t('monitor.member_paths')
          p= t('monitor.scope_note')
        if monitor.probe.available
          span.status-pill.is-online
            span.status-dot
            | #{t('monitor.probe_available')}
        else
          span.status-pill.is-offline
            span.status-dot
            | #{t('monitor.probe_unavailable')}
      .list-toolbar(data-list-controls hidden)
        input.form-control(type='search' data-list-search placeholder=t('ux.search_members') aria-label=t('ux.search_members'))
      .table-responsive
        table.table.app-table.monitor-table
          thead
            tr
              th= t('network.device')
              th= t('monitor.networks')
              th= t('monitor.planet_view')
              th= t('monitor.probe_view')
              th= t('monitor.risk')
          tbody
            each member in monitor.members
              tr(data-list-row data-search=[member.name, member.id, member.planet.path, member.probe.path].concat(member.networks.map(network => network.name + ' ' + network.nwid)).join(' '))
                td
                  details.member-quick-info(id='observed-member-' + member.id data-dialog data-dialog-title=t('member.detail_title'))
                    summary(data-tooltip=t('member.quick_hint'))
                      strong= member.name || member.id
                    .detail-grid
                      .detail-item
                        span= t('member.address')
                        code= member.id
                      .detail-item
                        span= t('member.client_version')
                        strong= member.version || t('common.unknown')
                    h3= t('monitor.planet_view')
                    .detail-grid
                      .detail-item.detail-item-wide
                        span= t('member.observed_paths')
                        if member.planet.reachable && member.planet.path
                          code= member.planet.path
                        else
                          strong= t('member.no_observed_path')
                      .detail-item
                        span= t('member.observed_latency')
                        strong= Number.isFinite(member.planet.latency) && member.planet.latency >= 0 ? member.planet.latency + ' ms' : t('common.unknown')
                      .detail-item
                        span= t('member.path_activity')
                        strong= Number.isFinite(member.planet.lastActivityMs) && member.planet.lastActivityMs >= 0 ? t('monitor.activity_ago', {age: formatAge(member.planet.lastActivityMs)}) : t('common.unknown')
                    h3= t('monitor.probe_view')
                    p
                      case member.probe.state
                        when 'direct'
                          span.path-badge.is-direct DIRECT
                        when 'relay'
                          span.path-badge.is-relay RELAY
                        when 'tcp_relay'
                          span.path-badge.is-relay TCP RELAY
                        when 'self'
                          span.path-badge.is-self= t('monitor.probe_self')
                        when 'unknown'
                          span.path-badge.is-unknown= t('monitor.unknown')
                        default
                          span.path-badge.is-unknown= t('monitor.unavailable')
                    .detail-grid
                      .detail-item.detail-item-wide
                        span= t('member.observed_paths')
                        if member.probe.path
                          code= member.probe.path
                        else
                          strong= t('member.no_observed_path')
                      .detail-item
                        span= t('member.observed_latency')
                        strong= Number.isFinite(member.probe.latency) && member.probe.latency >= 0 ? member.probe.latency + ' ms' : t('common.unknown')
                    p.monitor-footnote= t('monitor.scope_note')
                    h3= t('monitor.networks')
                    each network in member.networks
                      section
                        h4= network.name || network.nwid
                        code= network.nwid
                        .detail-grid
                          .detail-item
                            span= t('network.authorized')
                            strong= network.authorized === true ? t('common.enabled') : network.authorized === false ? t('common.disabled') : t('common.unknown')
                          .detail-item
                            span= t('network.bridge')
                            strong= network.activeBridge === true ? t('common.enabled') : network.activeBridge === false ? t('common.disabled') : t('common.unknown')
                        .form-actions
                          a.btn.btn-default(href='/controller/network/' + network.nwid + '/member/' + member.id)= t('network.member_detail')
                          a.btn.btn-default(href='/controller/network/' + network.nwid + '/member/' + member.id + '/ipAssignments')= t('network.edit_ip')
                  if member.name
                    code.monitor-member-id= member.id
                  small.member-version= member.version ? 'v' + member.version : t('common.unknown')
                td
                  each network in member.networks
                    a.monitor-network-link(href='/controller/network/' + network.nwid)= network.name || network.nwid
                td
                  if member.planet.reachable
                    span.path-badge.is-direct= t('monitor.to_planet_direct')
                    small.monitor-path-meta
                      | #{Number.isFinite(member.planet.latency) && member.planet.latency >= 0 ? member.planet.latency + ' ms' : t('common.unknown')}
                      if Number.isFinite(member.planet.lastActivityMs) && member.planet.lastActivityMs >= 0
                        |  · #{t('monitor.activity_ago', {age: formatAge(member.planet.lastActivityMs)})}
                    if member.planet.path
                      code.monitor-path= member.planet.path
                  else
                    span.path-badge.is-unknown= t('monitor.planet_unreachable')
                td
                  case member.probe.state
                    when 'direct'
                      span.path-badge.is-direct DIRECT
                    when 'relay'
                      span.path-badge.is-relay RELAY
                    when 'tcp_relay'
                      span.path-badge.is-relay TCP RELAY
                    when 'self'
                      span.path-badge.is-self= t('monitor.probe_self')
                    when 'unknown'
                      span.path-badge.is-unknown= t('monitor.unknown')
                    default
                      span.path-badge.is-unknown= t('monitor.unavailable')
                  if Number.isFinite(member.probe.latency) && member.probe.latency >= 0
                    small.monitor-path-meta #{member.probe.latency} ms
                  if member.probe.path
                    code.monitor-path= member.probe.path
                td
                  if member.activeBridge
                    a.risk-badge(href='#bridge-guidance' data-dialog-open='bridge-guidance')= t('monitor.bridge_enabled')
                  if member.versionBehind
                    a.risk-badge(href='#version-guidance' data-dialog-open='version-guidance')= t('monitor.old_client')
                  if !member.activeBridge && !member.versionBehind
                    span.muted-text= t('common.none')
            else
              tr
                td.empty-table-cell(colspan='5')= t('monitor.no_members')
      p.list-empty(data-list-empty hidden)= t('ux.no_results')
      .list-pagination(data-list-controls hidden)
        output(data-list-count aria-live='polite')
        .list-pagination-actions
          button.btn.btn-default.btn-sm(type='button' data-list-prev)= t('ux.previous')
          button.btn.btn-default.btn-sm(type='button' data-list-next)= t('ux.next')

    details.scope-disclosure(data-dialog)
      summary= t('ux.scope_details')
      p.monitor-footnote= t('monitor.relay_limit_note')

    details#endpoint-probes.surface-card.table-card.monitor-network-card.monitor-disclosure(data-dialog data-dialog-title=t('monitor.endpoint_probes'))
      summary.card-heading.card-heading-padded
        div
          h2= t('monitor.endpoint_probes')
        if monitor.endpointProbes && monitor.endpointProbes.available && monitor.endpointProbes.configuredCount
          span.status-pill(class=monitor.endpointProbes.failedCount ? 'is-offline' : 'is-online')
            span.status-dot
            | #{monitor.endpointProbes.reachableCount} / #{monitor.endpointProbes.configuredCount} #{t('monitor.endpoint_probe_reachable_short')}
        else if monitor.endpointProbes && monitor.endpointProbes.configured && !monitor.endpointProbes.available
          span.status-pill.is-offline
            span.status-dot
            | #{t('monitor.endpoint_probe_config_error_short')}
        else if monitor.endpointProbes && monitor.endpointProbes.configured
          span.status-pill.is-online
            span.status-dot
            | #{t('monitor.endpoint_probe_empty_short')}
        else
          span.status-pill.is-unknown
            | #{t('monitor.endpoint_probe_unconfigured')}
      p.monitor-footnote= t('monitor.endpoint_probes_desc')
      if !monitor.endpointProbes || !monitor.endpointProbes.configured
        .alert.alert-info= t('monitor.endpoint_probe_unconfigured_desc')
      else if !monitor.endpointProbes.available
        .alert.alert-warning= t('monitor.endpoint_probe_config_error', {code: monitor.endpointProbes.errorCode || '—'})
      else
        .table-responsive
          table.table.app-table.monitor-table
            thead
              tr
                th= t('monitor.endpoint_probe_name')
                th= t('monitor.endpoint_probe_address')
                th= t('monitor.endpoint_probe_state')
                th= t('monitor.endpoint_probe_latency')
                th= t('monitor.endpoint_probe_error')
            tbody
              each endpoint in monitor.endpointProbes.results
                tr
                  td
                    strong= endpoint.name
                    if endpoint.enabled === false
                      small.monitor-path-meta= t('monitor.endpoint_probe_disabled')
                  td
                    code.monitor-path= endpoint.addressLabel + ':' + endpoint.port
                  td
                    span.path-badge(class=endpoint.state === 'reachable' ? 'is-direct' : endpoint.state === 'disabled' ? 'is-self' : 'is-unknown')= t('monitor.endpoint_probe_state_' + endpoint.state)
                  td= endpoint.latencyMs === null ? '—' : endpoint.latencyMs + ' ms'
                  td
                    if endpoint.errorCode
                      code= endpoint.errorCode
                    else
                      span.muted-text= t('common.none')
              else
                tr
                  td.empty-table-cell(colspan='5')= t('monitor.endpoint_probe_empty')
        p.monitor-footnote= t('monitor.endpoint_probe_scope_note')

    details.monitor-disclosure.surface-card.monitor-service-details(data-dialog)
      summary= t('ux.service_details')
      .row.monitor-card-row
        .col-md-6
          section#service-status.surface-card.monitor-card
            .card-heading
              div
                h2= t('monitor.service_status')
                p= t('monitor.generated_at', {time: monitor && monitor.generatedAt || '—'})
            .detail-grid
              .detail-item
                span= t('dashboard.node_address')
                code= monitor.service.address
              .detail-item
                span= t('dashboard.zt_version')
                strong= monitor.service.version
              .detail-item
                span= t('monitor.planet_hash')
                strong= monitor.service.planetMatches ? t('monitor.consistent') : t('monitor.inconsistent')
              .detail-item
                span= t('monitor.unexpected_roots')
                strong= monitor.service.unexpectedPlanetCount === null ? '—' : monitor.service.unexpectedPlanetCount
              .detail-item
                span= t('dashboard.tcp_fallback')
                strong= monitor.service.tcpFallbackActive ? t('dashboard.active') : t('dashboard.inactive')
              .detail-item
                span= t('monitor.ui_uptime')
                strong= formatAge(monitor.service.uptimeSeconds * 1000)
        .col-md-6
          section#service-traffic.surface-card.monitor-card
            .card-heading
              div
                h2= t('monitor.traffic')
                p= t('monitor.traffic_desc')
            if monitor.metrics.available
              .detail-grid
                .detail-item
                  span= t('monitor.udp_rx')
                  strong= formatBytes(monitor.metrics.traffic.udpRx)
                  small= monitor.metrics.rates.traffic ? formatRate(monitor.metrics.rates.traffic.udpRx, 'B') : t('monitor.rate_waiting')
                .detail-item
                  span= t('monitor.udp_tx')
                  strong= formatBytes(monitor.metrics.traffic.udpTx)
                  small= monitor.metrics.rates.traffic ? formatRate(monitor.metrics.rates.traffic.udpTx, 'B') : t('monitor.rate_waiting')
                .detail-item
                  span= t('monitor.tcp_rx')
                  strong= formatBytes(monitor.metrics.traffic.tcpRx)
                .detail-item
                  span= t('monitor.tcp_tx')
                  strong= formatBytes(monitor.metrics.traffic.tcpTx)
                .detail-item
                  span= t('monitor.packet_rx')
                  strong= monitor.metrics.rates.packets ? formatRate(monitor.metrics.rates.packets.rx, 'pkt') : t('monitor.rate_waiting')
                .detail-item
                  span= t('monitor.packet_tx')
                  strong= monitor.metrics.rates.packets ? formatRate(monitor.metrics.rates.packets.tx, 'pkt') : t('monitor.rate_waiting')
            else
              .alert.alert-info= t('monitor.metrics_waiting')


    section.surface-card.monitor-card.guidance-card
      .card-heading
        h2= t('guide.actions')
      .guidance-links
        details#version-guidance.scope-disclosure(data-dialog)
          summary= t('guide.version_title')
          p= t('guide.version_scope', {version: monitor.service.version || '—'})
          ol
            li= t('guide.version_backup')
            li
              p= t('guide.version_upgrade')
              a(href='https://www.zerotier.com/download/' target='_blank' rel='noopener noreferrer')= t('guide.official_download')
            li
              p= t('guide.version_android')
              a(href='https://github.com/kaaass/ZerotierFix/releases' target='_blank' rel='noopener noreferrer')= t('guide.android_releases')
            li= t('guide.version_verify')
        details#bridge-guidance.scope-disclosure(data-dialog)
          summary= t('guide.bridge_title')
          p= t('guide.bridge_scope')
          p= t('guide.bridge_fix')
        details#planet-guidance.scope-disclosure(data-dialog)
          summary= t('guide.planet_title')
          p= t('guide.planet_fix')
          p= t('guide.planet_verify')
        details#path-guidance.scope-disclosure(data-dialog)
          summary= t('guide.path_title')
          p= t('guide.path_fix')
          p= t('guide.path_relay')
      p
        a(href='https://github.com/Csneer/zerotier-planet-ms/blob/main/docs/client-troubleshooting.md' target='_blank' rel='noopener noreferrer')= t('guide.project_doc')
