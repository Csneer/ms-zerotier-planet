extends login_layout

block login_content
  .auth-heading
    span.eyebrow Self-hosted network control
    h1 Private networking without the clutter.
    p Manage your controller, networks, members, MTU, and generated Planet files from one focused console.
  a.btn.btn-primary.btn-lg.btn-block(href='/login')
    span.glyphicon.glyphicon-log-in(aria-hidden='true')
    |  Open control center
  .auth-footnote
    span.status-dot
    | Optimized self-hosted ZeroTier deployment
