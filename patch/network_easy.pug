extends network_layout

block net_content
  script(src='/javascripts/networkValidation.js')
  script.
    function randomOctet() {
      return Math.floor(Math.random() * 255);
    }

    function randomIPv4() {
      var CIDR = '10.' + randomOctet() + '.' + randomOctet() + '.0/24';
      document.getElementById('networkCIDR').value = CIDR;
      CIDRtoPool(CIDR);
    }

    function int32toIPv4String(int32) {
      return ((int32 & 0xff000000) >>> 24) + '.' +
        ((int32 & 0x00ff0000) >>> 16) + '.' +
        ((int32 & 0x0000ff00) >>> 8) + '.' +
        (int32 & 0x000000ff);
    }

    function CIDRtoPool(CIDR) {
      var range = networkValidation.cidr(CIDR);
      var field = document.getElementById('networkCIDR');
      field.setCustomValidity(range ? '' : !{JSON.stringify(t('network.invalid_cidr'))});
      if (!range) {
        field.reportValidity();
        return;
      }
      field.value = int32toIPv4String(range.network) + '/' + range.prefix;
      document.getElementById('poolStart').value = int32toIPv4String(range.first);
      document.getElementById('poolEnd').value = int32toIPv4String(range.last);
    }

    function validateEasyForm() {
      var cidr = document.getElementById('networkCIDR');
      var start = document.getElementById('poolStart');
      var end = document.getElementById('poolEnd');
      cidr.setCustomValidity('');
      end.setCustomValidity('');
      var error = networkValidation.validate({networkCIDR: cidr.value, poolStart: start.value, poolEnd: end.value});
      if (!error) return true;
      var field = error === 'network.invalid_cidr' ? cidr : end;
      field.setCustomValidity(error === 'network.invalid_cidr' ? !{JSON.stringify(t('network.invalid_cidr'))} : !{JSON.stringify(t('network.invalid_pool'))});
      field.reportValidity();
      return false;
    }

  section.surface-card.form-card
    .card-heading
      div
        h2= t('network.easy_title')
        p= t('network.easy_help_text')

    if message
      .alert.alert-success
        strong= t('network.setup_success')
    if error
      .alert.alert-danger= error
    if errors
      .alert.alert-danger
        ul.compact-list
          each err in errors
            li= localize_error(err.msg)

    .alert.alert-info
      strong= t('network.easy_ipv4_only')

    form(method='POST' action='' onsubmit='return validateEasyForm()' oninput="document.getElementById('networkCIDR').setCustomValidity(''); document.getElementById('poolEnd').setCustomValidity('')")
      .form-actions.form-actions-top
        button#genIPv4.btn.btn-default(type='button' onclick='randomIPv4()')
          span.glyphicon.glyphicon-random(aria-hidden='true')
          |  #{t('network.generate_address')}
      .form-group
        label(for='networkCIDR')= t('network.cidr')
        input#networkCIDR.form-control(type='text' name='networkCIDR' onchange='CIDRtoPool(this.value)' placeholder='10.11.12.0/24' value=(network.routes && network.routes[0] ? network.routes[0].target : ''))
      .form-row
        .form-group
          label(for='poolStart')= t('network.pool_start')
          input#poolStart.form-control(type='text' name='poolStart' placeholder='10.11.12.1' value=(network.ipAssignmentPools && network.ipAssignmentPools[0] ? network.ipAssignmentPools[0].ipRangeStart : ''))
        .form-group
          label(for='poolEnd')= t('network.pool_end')
          input#poolEnd.form-control(type='text' name='poolEnd' placeholder='10.11.12.254' value=(network.ipAssignmentPools && network.ipAssignmentPools[0] ? network.ipAssignmentPools[0].ipRangeEnd : ''))
      .form-actions
        button.btn.btn-primary(type='submit')= t('common.save')
        a.btn.btn-default(href='/controller/network/' + network.nwid)= t('common.cancel')
