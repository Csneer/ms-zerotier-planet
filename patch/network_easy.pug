extends network_layout

block net_content
  script.
    function randomOctet() {
      return Math.floor(Math.random() * 255);
    }

    function randomIPv4() {
      var CIDR = '10.' + randomOctet() + '.' + randomOctet() + '.0/24';
      document.getElementById('networkCIDR').value = CIDR;
      CIDRtoPool(CIDR);
    }

    function int32toIPv4String(int32) {
      return ((int32 & 0xff000000) >>> 24) + '.' +
        ((int32 & 0x00ff0000) >>> 16) + '.' +
        ((int32 & 0x0000ff00) >>> 8) + '.' +
        (int32 & 0x000000ff);
    }

    function CIDRtoPool(CIDR) {
      var parts = CIDR.split('/');
      var start = parts[0];
      var prefix = Number(parts[1]);
      var valid = prefix > 0 && prefix < 33 &&
        /^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/.test(start);
      var poolStart = document.getElementById('poolStart');
      var poolEnd = document.getElementById('poolEnd');
      if (!valid) {
        poolStart.value = !{JSON.stringify(t('network.invalid_cidr'))};
        poolEnd.value = !{JSON.stringify(t('network.invalid_cidr'))};
        return;
      }
      var host32 = ((1 << (32 - prefix)) - 1) >>> 0;
      var octets = start.split('.').map(Number);
      var net32 = ((octets[0] << 24) + (octets[1] << 16) + (octets[2] << 8) + octets[3]) >>> 0;
      net32 = (net32 & ~host32) >>> 0;
      document.getElementById('networkCIDR').value = int32toIPv4String(net32) + '/' + prefix;
      poolStart.value = int32toIPv4String((net32 + 1) >>> 0);
      poolEnd.value = int32toIPv4String((net32 + host32 - 1) >>> 0);
    }

  section.surface-card.form-card
    .card-heading
      div
        h2= t('network.easy_title')
        p= t('network.easy_help_text')

    if message
      .alert.alert-success
        strong= t('network.setup_success')
    if error
      .alert.alert-danger= error
    if errors
      .alert.alert-danger
        ul.compact-list
          each err in errors
            li= localize_error(err.msg)

    .alert.alert-info
      strong= t('network.easy_ipv4_only')

    form(method='POST' action='')
      .form-actions.form-actions-top
        button#genIPv4.btn.btn-default(type='button' onclick='randomIPv4()')
          span.glyphicon.glyphicon-random(aria-hidden='true')
          |  #{t('network.generate_address')}
      .form-group
        label(for='networkCIDR')= t('network.cidr')
        input#networkCIDR.form-control(type='text' name='networkCIDR' onchange='CIDRtoPool(this.value)' placeholder='10.11.12.0/24' value=(network.routes && network.routes[0] ? network.routes[0].target : ''))
      .form-row
        .form-group
          label(for='poolStart')= t('network.pool_start')
          input#poolStart.form-control(type='text' name='poolStart' placeholder='10.11.12.1' value=(network.ipAssignmentPools && network.ipAssignmentPools[0] ? network.ipAssignmentPools[0].ipRangeStart : ''))
        .form-group
          label(for='poolEnd')= t('network.pool_end')
          input#poolEnd.form-control(type='text' name='poolEnd' placeholder='10.11.12.254' value=(network.ipAssignmentPools && network.ipAssignmentPools[0] ? network.ipAssignmentPools[0].ipRangeEnd : ''))
      .form-actions
        button.btn.btn-primary(type='submit')= t('common.save')
        a.btn.btn-default(href='/controller/network/' + network.nwid)= t('common.cancel')
