extends head_layout

block nav_login
  a(href='/login')
    span.glyphicon.glyphicon-log-in(aria-hidden='true')
    span.nav-label= t('nav.sign_in')

block body_content
  main#main-content.auth-shell
    .auth-backdrop
    .auth-card
      .auth-brand
        span.brand-mark ZT
        div
          strong ZeroTier Planet
          small= t('app.private_control_center')
      block login_content
