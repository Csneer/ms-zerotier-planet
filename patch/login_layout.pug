extends head_layout

block app_navigation
  header.auth-navigation
    a(href=language_url(lang === 'zh-CN' ? 'en' : 'zh-CN') title=t('language.switch'))= lang === 'zh-CN' ? 'English' : '中文'

block body_content
  main#main-content.auth-shell
    .auth-backdrop
    .auth-card
      .auth-brand
        span.brand-mark(aria-hidden='true') ZT
        div
          strong ZeroTier Planet
      block login_content
