   res.redirect('/controller/network/' + req.params.nwid);
 };

+// MTU GET/POST. ZeroTier accepts 1280..2800 for virtual networks. Keeping
+// validation here prevents malformed values from reaching the controller API.
+exports.mtu_get = async function(req, res) {
+  const navigate = {
+    active: 'networks',
+    whence: '/controller/network/' + req.params.nwid
+  };
+
+  try {
+    const network = await zt.network_detail(req.params.nwid);
+    res.render('mtu', {title: 'MTU', navigate: navigate, network: network});
+  } catch (err) {
+    res.render('mtu', {title: 'MTU', navigate: navigate,
+      error: 'Error retrieving MTU for network ' + req.params.nwid + ': ' + err});
+  }
+};
+
+exports.mtu_post = async function(req, res) {
+  const navigate = {
+    active: 'networks',
+    whence: '/controller/network/' + req.params.nwid
+  };
+  const rawMtu = String(req.body.mtu === undefined ? '' : req.body.mtu).trim();
+  const mtu = Number(rawMtu);
+
+  try {
+    let network = await zt.network_detail(req.params.nwid);
+    if (!/^\d+$/.test(rawMtu) || !Number.isInteger(mtu) || mtu < 1280 || mtu > 2800) {
+      return res.status(400).render('mtu', {
+        title: 'MTU', navigate: navigate, network: network,
+        errors: [{msg: 'MTU must be a whole number between 1280 and 2800.'}],
+        submittedMtu: rawMtu
+      });
+    }
+
+    network = await zt.network_object(req.params.nwid, {mtu: mtu});
+    res.render('mtu', {
+      title: 'MTU', navigate: navigate, network: network,
+      success: 'MTU updated to ' + network.mtu + '. Online members will receive the new configuration automatically.'
+    });
+  } catch (err) {
+    res.status(502).render('mtu', {title: 'MTU', navigate: navigate,
+      error: 'Error applying MTU for network ' + req.params.nwid + ': ' + err});
+  }
+};
+
