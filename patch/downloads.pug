extends controller_layout

block content
  .page-heading
    div
      span.eyebrow Client bootstrap
      h1 Configuration files
      p Download signed Planet and Moon files generated by this controller.

  .alert.alert-info(role='alert')
    strong Planet clients:
    |  download the planet file and replace the client's existing planet file while ZeroTier is stopped.
    br
    strong Moon clients:
    |  use the .moon file only when configuring this server as a Moon.

  if error
    .alert.alert-danger(role='alert')= error
  else if !files.length
    .alert.alert-warning(role='alert') No generated Planet or Moon files are available.
  else
    .surface-card.table-card
      .table-responsive
        table.table.app-table
          thead
            tr
              th Type
              th File
              th Size
              th Modified (UTC)
              th SHA-256
              th.text-right Action
          tbody
            each file in files
              tr
                td
                  span.label(class=file.type === 'Planet' ? 'label-primary' : 'label-info')= file.type
                td
                  code.network-id= file.name
                td #{file.size} bytes
                td= file.modified
                td
                  code(style='word-break: break-all;')= file.sha256
                td.text-right
                  a.btn.btn-primary.btn-sm(
                    href='/controller/downloads/' + file.name
                    download=file.name
                    role='button'
                  )
                    span.glyphicon.glyphicon-download-alt(aria-hidden='true')
                    |  Download
