 }

+function managedMemberIds(memberResponse) {
+  const ids = new Set();
+  if (Array.isArray(memberResponse)) {
+    for (const item of memberResponse) {
+      if (item && typeof item === 'object') {
+        for (const id of Object.keys(item)) {
+          if (/^[0-9a-f]{10}$/i.test(id)) ids.add(id.toLowerCase());
+        }
+      }
+    }
+  } else if (memberResponse && typeof memberResponse === 'object') {
+    for (const id of Object.keys(memberResponse)) {
+      if (/^[0-9a-f]{10}$/i.test(id)) ids.add(id.toLowerCase());
+    }
+  }
+  return ids;
+}
+
+function peerIsOnline(peer) {
+  return Boolean(peer) && Number(peer.latency) >= 0 &&
+    (peer.versionMajor === undefined || peer.versionMajor !== -1);
+}
+
+async function get_dashboard_stats() {
+  const [networks, peers] = await Promise.all([
+    zt.network_list(),
+    zt.peers()
+  ]);
+  const memberResponses = await Promise.all(
+    networks.map(network => zt.members(network.nwid))
+  );
+  const memberIds = new Set();
+  for (const response of memberResponses) {
+    for (const id of managedMemberIds(response)) memberIds.add(id);
+  }
+  const peerByAddress = new Map(
+    (Array.isArray(peers) ? peers : []).map(peer => [String(peer.address).toLowerCase(), peer])
+  );
+  const onlineMemberCount = [...memberIds]
+    .filter(id => peerIsOnline(peerByAddress.get(id))).length;
+  return {available: true, networkCount: networks.length,
+    memberCount: memberIds.size, onlineMemberCount: onlineMemberCount};
+}
