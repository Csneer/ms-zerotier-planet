include icons

mixin nav_item(name, displayName, href, icon)
  - var isActive = !!(navigate && navigate.active === name)
  li(class=(isActive ? 'active' : ''))
    a(href=href class='app-nav-link' aria-current=(isActive ? 'page' : undefined))
      if icon
        +app_icon(icon)
      span.nav-label= displayName

mixin json_value(value)
  - if ((!!value) && (value.constructor == Object || value.constructor == Array))
      code(style='white-space: pre-wrap; word-break: break-word;')= JSON.stringify(value, null, 2)
  - else
      code= value

doctype html
html(lang=lang || 'zh-CN')
  head
    title #{t('app.control_center')} · ZeroTier Planet
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(name='theme-color' content='#101827')
    link(rel='stylesheet' href='/bscss/bootstrap.min.css')
    link(rel='stylesheet' href='/stylesheets/style.css')
    link(rel='stylesheet' href='/stylesheets/ui-modern.css')
    script(src='/jqjs/jquery.min.js')
    script(src='/bsjs/bootstrap.min.js')
    script(src='/javascripts/ui-focus.js' defer)
  body(data-dialog-close=t('common.close'))
    a.app-skip-link(href='#main-content')= lang === 'zh-CN' ? '跳转到内容' : 'Skip to content'
    block app_navigation
      nav.navbar.navbar-inverse.navbar-fixed-top.app-navbar
        .container-fluid.app-navbar-inner
          .navbar-header
            button.navbar-toggle.collapsed(type='button' data-toggle='collapse' data-target='#appNavigation' aria-expanded='false')
              span.sr-only= t('nav.toggle')
              span.icon-bar
              span.icon-bar
              span.icon-bar
            a.navbar-brand.app-brand(href='/controller')
              span.brand-mark ZT
              span.brand-text
                strong ZeroTier Planet
                small= t('app.control_center')
          .collapse.navbar-collapse#appNavigation
            ul.nav.navbar-nav.app-nav
              block nav_items
            ul.nav.navbar-nav.navbar-right.app-nav
              li.language-menu
                a(href=language_url(lang === 'zh-CN' ? 'en' : 'zh-CN') title=t('language.switch'))
                  +app_icon('globe')
                  span.nav-label= lang === 'zh-CN' ? t('language.english') : t('language.chinese')
              li
                block nav_login
                  a(href='/logout')
                    +app_icon('log-out')
                    span.nav-label= t('nav.sign_out')
    block body_content
