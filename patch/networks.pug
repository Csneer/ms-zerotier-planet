extends controller_layout

block content
  .page-heading
    div
      span.eyebrow= t('networks.eyebrow')
      h1= t('networks.title')
      p= t('networks.description')
    .page-heading-actions
      span.page-count-badge
        span.glyphicon.glyphicon-th-large(aria-hidden='true')
        |  #{networks.length}
      a.btn.btn-primary.btn-lg(href='/controller/network/create')
        +app_icon('plus')
        |  #{t('nav.new_network')}

  if error
    .alert.alert-danger= error
  else if !networks.length
    .empty-state
      +app_icon('globe')
      h3= t('networks.empty_title')
      p= t('networks.empty_description')
      a.btn.btn-primary(href='/controller/network/create')= t('network.create_button')
  else
    .surface-card.table-card.network-list-card(data-list data-list-summary=t('ux.list_count'))
      .list-toolbar(data-list-controls hidden)
        input.form-control(type='search' data-list-search placeholder=t('ux.search_networks') aria-label=t('ux.search_networks'))
      .table-responsive
        table.table.app-table
          thead
            tr
              th= t('networks.network')
              th= t('networks.network_id')
              th.text-right= t('common.actions')
          tbody
            each network in networks
              - const nwurl = '/controller/network/' + network.nwid;
              tr.network-row(data-list-row data-search=[network.name || '', network.nwid].join(' '))
                td
                  a.network-name(href=nwurl)
                    span.network-avatar= (network.name || 'N').charAt(0).toUpperCase()
                    span
                      strong= network.name
                      small= network.private === false ? t('networks.public_virtual') : t('networks.private_virtual')
                td
                  code.network-id= network.nwid
                td.text-right.table-actions
                  .network-actions
                    a.btn.btn-default.btn-sm(href=nwurl + '#members')= t('networks.members')
                    a.btn.btn-default.btn-sm(href=nwurl + '/easy')= t('networks.easy_setup')
                    a.btn.btn-primary.btn-sm(href=nwurl)= t('networks.configure')
                    a.btn.btn-link.btn-sm.danger-link(
                      href=nwurl + '/delete'
                      title=t('networks.delete_title')
                      aria-label=t('networks.delete_title')
                    )
                      span.glyphicon.glyphicon-trash(aria-hidden='true')
      p.list-empty(data-list-empty hidden)= t('ux.no_results')
      .list-pagination(data-list-controls hidden)
        output(data-list-count aria-live='polite')
        .list-pagination-actions
          button.btn.btn-default.btn-sm(type='button' data-list-prev)= t('ux.previous')
          button.btn.btn-default.btn-sm(type='button' data-list-next)= t('ux.next')
