extends controller_layout

block content
  .page-heading
    div
      span.eyebrow= t('networks.eyebrow')
      h1= t('networks.title')
      p= t('networks.description')
    a.btn.btn-primary.btn-lg(href='/controller/network/create')
      span.glyphicon.glyphicon-plus(aria-hidden='true')
      |  #{t('nav.new_network')}

  if error
    .alert.alert-danger= error
  else if !networks.length
    .empty-state
      span.glyphicon.glyphicon-globe
      h3= t('networks.empty_title')
      p= t('networks.empty_description')
      a.btn.btn-primary(href='/controller/network/create')= t('network.create_button')
  else
    .surface-card.table-card
      .table-responsive
        table.table.app-table
          thead
            tr
              th= t('networks.network')
              th= t('networks.network_id')
              th.text-right= t('common.actions')
          tbody
            each network in networks
              - const nwurl = '/controller/network/' + network.nwid;
              tr
                td
                  a.network-name(href=nwurl)
                    span.network-avatar= (network.name || 'N').charAt(0).toUpperCase()
                    span
                      strong= network.name
                      small= network.private === false ? t('networks.public_virtual') : t('networks.private_virtual')
                td
                  code.network-id= network.nwid
                td.text-right.table-actions
                  a.btn.btn-default.btn-sm(href=nwurl + '#members')= t('networks.members')
                  a.btn.btn-default.btn-sm(href=nwurl + '/easy')= t('networks.easy_setup')
                  a.btn.btn-primary.btn-sm(href=nwurl)= t('networks.configure')
                  a.btn.btn-link.btn-sm.danger-link(href=nwurl + '/delete' title=t('networks.delete_title'))
                    span.glyphicon.glyphicon-trash
