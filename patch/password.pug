extends users_layout

block users_content
  .content-card-body
    .card-heading
      div
        h2= t('users.password_title')
        p= t('users.password_description')

    if message
      .alert.alert-info
        strong= errors ? localize_error(message) : t('users.password_saved', {name: user.name})
    if errors
      .alert.alert-danger
        ul.compact-list
          each err in errors
            li= localize_error(err.msg)

    form(method='POST' action='')
      .form-group
        label(for='username')= t('users.username')
        .input-group
          span.input-group-addon
            span.glyphicon.glyphicon-user(aria-hidden='true')
          input#username.form-control(type='text' name='username' placeholder=t('login.username_placeholder') value=(user && user.name ? user.name : '') readonly=readonly required=true)
      .form-group
        label(for='password1')= t('users.new_password')
        .input-group
          span.input-group-addon
            span.glyphicon.glyphicon-lock(aria-hidden='true')
          input#password1.form-control(type='password' name='password1' placeholder=t('users.new_password') autocomplete='new-password' required=true)
      .form-group
        label(for='password2')= t('users.confirm_password')
        .input-group
          span.input-group-addon
            span.glyphicon.glyphicon-lock(aria-hidden='true')
          input#password2.form-control(type='password' name='password2' placeholder=t('users.confirm_password') autocomplete='new-password' required=true)
      label.checkbox-row(for='pass_set')
        input#pass_set(type='checkbox' name='pass_set' value='check')
        span= t('users.change_next_login')
      .form-actions
        button.btn.btn-primary(type='submit')= t('users.save_password')
        a.btn.btn-default(href='/users')= t('common.cancel')
